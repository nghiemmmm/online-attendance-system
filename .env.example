# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace placeholders with your actual secrets.
# ==============================================================================

# Application Settings
APP_NAME=DIEMDANHTUDONG
VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
FRONTEND_HOST=http://localhost:3000
API_URL=http://127.0.0.1:8000

# Security & JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_TOKEN=your-api-token-change-in-production

# First Superuser (Admin) Account
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin123456

# Database Connection (PostgreSQL)
# Local Docker/Dev default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# Google OAuth2 (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
REDIRECT_URI=http://localhost:8000/auth/callback

# SMTP Mail Service (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME="Hệ Thống Điểm Danh Tự Động"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Image Storage Provider ("LOCAL" or "CLOUDINARY")
IMAGE_STORAGE_PROVIDER=LOCAL

# AI Face Recognition Settings
FACE_RECOGNITION_TOLERANCE=0.85

# Redis Cache
REDIS_URL=redis://localhost:6379/0
