# ==============================================================================
# BASE DEPENDENCIES IMAGE FOR AI FACE ATTENDANCE BACKEND
# ==============================================================================
# Use official lightweight Python image based on Debian Bookworm
FROM python:3.11-slim-bookworm

# Set Python environment variables for container optimization
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

# Set workspace directory
WORKDIR /app

# Install system dependencies
# Installs C/C++ build tools (required for compiling packages like faiss, insightface),
# PostgreSQL client development files, OpenGL, glib, and ffmpeg for media processing.
# Cleans APT cache and removes indexes immediately in the same layer to minimize image size.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    curl \
    libpq-dev \
    libglib2.0-0 \
    libgl1 \
    ffmpeg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create application user
# Creates a non-privileged group and user (appuser) to run the container without root privileges.
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -m -s /bin/bash appuser && \
    chown -R appuser:appgroup /app

# Copy dependencies definition first to leverage Docker Layer Caching
COPY requirements.txt /app/requirements.txt

# Install Python packages
# Upgrades pip to the latest version, installs all backend requirements,
# and verifies dependency resolution consistency with 'pip check'.
RUN pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip check

# Switch execution context to the non-root user for security
USER appuser
